package templates

templ LoginPage(toasts []Toast) {
	@Layout(toasts) {
		<div>
			<h1>Login</h1>
			<form
				hx-post="/login"
				hx-target="#login_output"
				hx-swap="innerHTML"
			>
				<input name="email" placeholder="email" type="email"/>
				<input name="password" placeholder="password" type="password"/>
				<button type="submit">Submit</button>
			</form>
			<p>Have not account yet? <a href="/register" hx-get="/register" hx-target="body" hx-swap="innerHTML" hx-push-url="true">Register now!</a></p>	
			<div id="login_output"></div>
		</div>
	}
}
