        <ul>
            <li><a href="" hx-get="/profile" hx-target="body" hx-swap="outerHTML" hx-push-url="true">Profile</a></li> 
            <li><a href="" hx-get="/collections" hx-target="body" hx-swap="outerHTML" hx-push-url="true">Collections</a></li>
        </ul> 
        { children... }
    </div>
}