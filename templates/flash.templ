templ ToastItem(t Toast) {
		// hx-on:animationend="if (event.animationName === 'toastFadeOut') this.remove();"
	<div
		class={ "toast", "toast-" + string(t.Type) }
	>
		<span class="toast-message">{ t.Message }</span>
		<button type="button" class="toast-close" onclick="this.parentElement.remove()">✕</button>
	</div>
}

templ ToastOOB(t Toast) {
	<div id="toast-container" hx-swap-oob="beforeend">
		@ToastItem(t)
	</div>
}

templ ToastContainer(toasts []Toast) {
	// @ToastStyles()
	<div id="toast-container" class="toast-container">
		for _, t := range toasts {
			@ToastItem(t)
		}
	</div>
}
